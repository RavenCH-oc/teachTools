{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Classroom Teacher",
  "version": "0.1.0",
  "identifier": "com.classtools.teacher",
  "build": {
    "beforeDevCommand": "pnpm run dev:tauri-frontend",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build:tauri-frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Classroom Teacher",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/assets/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "../../student/dist": "student"
    }
  }
}
